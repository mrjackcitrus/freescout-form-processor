# FreeScout config.
FREESCOUT_API_URL=https://freescout.example.com/api/conversations
FREESCOUT_API_KEY=

# One request per company and client IP per interval (positive integer seconds).
RATE_LIMIT_SECONDS=5

# Minimum time between form load and submission (integer seconds; 0 allows immediate submission).
MIN_SUBMIT_SECONDS=5

# Minimum message length after trimming (integer characters, 1 to 5000).
MIN_MESSAGE_LENGTH=5

# Comma-separated literal words or phrases, matched case-insensitively at word boundaries.
# Leave empty to disable keyword blocking. Quote values containing spaces.
SPAM_KEYWORDS="viagra,cialis,loan approval,crypto"

# Comma-separated IP addresses of trusted reverse proxies (optional).
TRUSTED_PROXIES=

# Company mappings (you can have as many as you like).
COMPANY_MAILBOX_ID_COMPANYSLUG=1
COMPANY_ALLOWED_ORIGIN_COMPANYSLUG=https://example.com

COMPANY_MAILBOX_ID_ANOTHERCOMPANYSLUG=2
COMPANY_ALLOWED_ORIGIN_ANOTHERCOMPANYSLUG=https://example.net,http://localhost:8000
